# ==============================================================================
# Export Customs Documentation Compliance Checker - Root Configuration
# ==============================================================================

# Server / Backend Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_ENV=development
SERVER_LOG_LEVEL=INFO

# AI & LLM Service (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_VERSION=v1beta

# Database & Storage (Supabase PostgreSQL)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_api_key_here
SUPABASE_TABLE_NAME=customs_documents

# Vector Database (Pinecone Regulatory Intelligence)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=export-customs-rules
PINECONE_NAMESPACE=indian-export-regulations-v1
PINECONE_ENVIRONMENT=us-east-1

# Client / Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
